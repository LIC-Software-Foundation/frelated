# Docker Compose defaults for local execution

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=frelated
MYSQL_USER=frelated
MYSQL_PASSWORD=frelated
MYSQL_PORT=3307

MONGO_PORT=27018
MONGO_DB_NAME=frelated

PROJECTS_API_PORT=3000
COLLAB_SERVER_PORT=8080
WEB_EDITOR_UI_PORT=5173
WEB_MONITORING_UI_PORT=5174
COMPILATION_AUTOSCALER_PORT=3100

AUTH_SECRET=change-me-with-a-long-random-secret
DATA_ENCRYPTION_KEY=change-me-with-a-long-random-encryption-key

PERSISTENCE_DRIVER=mongodb
PRISMA_AUTO_MIGRATE=true

FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
PROJECTS_API_PUBLIC_URL=http://localhost:3000
COLLAB_SERVER_PUBLIC_URL=ws://localhost:8080

# Compilation distribuée (Redis privé, partagé avec les workers)
COMPILATION_TIMEOUT_MS=120000

# Autoscaling des workers de compilation (voir docs/Autoscaling.md)
COMPILATION_WORKER_IMAGE=frelated-compilation-worker
AUTOSCALER_POLL_INTERVAL_MS=5000
AUTOSCALER_SCALE_UP_THRESHOLD=3
AUTOSCALER_SCALE_DOWN_THRESHOLD=3
AUTOSCALER_MIN_WORKERS=1
AUTOSCALER_MAX_WORKERS=10
AUTOSCALER_SCALE_COOLDOWN_MS=30000
AUTOSCALER_ESTIMATED_WORKER_MEMORY_MB=320
AUTOSCALER_MIN_FREE_MEMORY_AFTER_SCALE_UP_MB=768
AUTOSCALER_MAX_CPU_LOAD_FRACTION_AFTER_SCALE_UP=0.85
AUTOSCALER_HEAVY_JOB_PAYLOAD_THRESHOLD_MB=3
AUTOSCALER_HEAVY_JOB_COUNT_THRESHOLD=2
AUTOSCALER_BUSY_WORKER_CPU_LOAD_THRESHOLD=0.8

# Invitations et liens sécurisés
APP_PUBLIC_URL=http://localhost:5173
GUEST_INVITATION_TTL_HOURS=168
PROJECT_MAX_GUEST_INVITATIONS=10
GUEST_SESSION_TTL_HOURS=12
PROJECT_JOIN_LINK_TTL_HOURS=168
PROJECT_MAX_PARTICIPANTS=0

# SMTP de développement. MailHog est lancé automatiquement par run-docker.sh.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Frelated <no-reply@frelated.local>

# LanguageTool est lancé automatiquement par run-docker.sh.
PROOFREADING_PROVIDER=languagetool
LANGUAGETOOL_URL=http://languagetool:8010/v2/check
LANGUAGETOOL_API_KEY=
PROOFREADING_DEFAULT_LANGUAGE=fr
