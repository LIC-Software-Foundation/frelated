PERSISTENCE_DRIVER=mongodb
DATABASE_URL=mysql://frelated:frelated@localhost:3306/frelated
MONGODB_URL=mongodb://localhost:27017/frelated
MONGODB_DB_NAME=frelated
AUTH_SECRET=change-me
DATA_ENCRYPTION_KEY=change-me-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
PRISMA_AUTO_MIGRATE=true
APP_PUBLIC_URL=http://localhost:5173
GUEST_INVITATION_TTL_HOURS=168
PROJECT_MAX_GUEST_INVITATIONS=10
GUEST_SESSION_TTL_HOURS=12
PROJECT_JOIN_LINK_TTL_HOURS=168
PROJECT_MAX_PARTICIPANTS=0

# Avec MailHog lancé dans Docker et l'API lancée sur l'hôte.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Frelated <no-reply@frelated.local>

# Correcteur compatible avec une instance LanguageTool auto-hébergée.
PROOFREADING_PROVIDER=languagetool
LANGUAGETOOL_URL=http://localhost:8010/v2/check
LANGUAGETOOL_API_KEY=
PROOFREADING_DEFAULT_LANGUAGE=fr
