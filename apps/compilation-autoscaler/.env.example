# Health/status HTTP server
HOST=0.0.0.0
PORT=3100

# Queue metrics API. The autoscaler does not connect to Redis directly.
COMPILATION_SERVICE_URL=http://localhost:3200
COMPILATION_AUTOSCALER_TOKEN=replace-with-an-autoscaler-token
COMPILATION_SERVICE_TIMEOUT_MS=3000

# Docker orchestration of compilation-worker containers
DOCKER_SOCKET_PATH=/var/run/docker.sock
COMPILATION_WORKER_IMAGE=frelated-compilation-worker
COMPILATION_WORKER_NETWORK=frelated-network

# Passed through to workers this service creates — same values as the
# baseline compilation-worker service in docker-compose.yml.
AUTH_SECRET=change-me
DATA_ENCRYPTION_KEY=change-me-with-a-long-random-encryption-key
COMPILATION_WORKER_REDIS_URL=redis://redis:6379
COMPILATION_WORKER_TOKEN=replace-with-a-worker-token
COMPILATION_TIMEOUT_MS=120000
COMPILATION_WORKER_MEMORY_MB=768
COMPILATION_WORKER_CPUS=1
COMPILATION_WORKER_PIDS_LIMIT=128
COMPILATION_WORKER_TMPFS_SIZE_MB=384

# Scaling loop cadence
POLL_INTERVAL_MS=5000

# Scaling policy — see src/domain/scalingPolicy.ts
SCALE_UP_THRESHOLD=3
SCALE_DOWN_THRESHOLD=3
MIN_WORKERS=1
# Hard-clamped to 10 regardless of this value — see ABSOLUTE_MAX_WORKERS_CEILING.
MAX_WORKERS=10
SCALE_COOLDOWN_MS=30000
ESTIMATED_WORKER_MEMORY_MB=320
MIN_FREE_MEMORY_AFTER_SCALE_UP_MB=768
MAX_CPU_LOAD_FRACTION_AFTER_SCALE_UP=0.85
# Number of heavy waiting jobs that alone justifies a scale-up.
HEAVY_JOB_COUNT_THRESHOLD=2
# Average CPU load (fraction of their own allotment) active workers must
# reach, while something waits, to alone justify a scale-up.
BUSY_WORKER_CPU_LOAD_THRESHOLD=0.8
